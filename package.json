{
  "name": "quota-deck",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.4.2",
  "publisher": "alexmultiagent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexMultiAgent/VSC-plugin-quota-deck.git"
  },
  "engines": {
    "vscode": "^1.101.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "minimax",
    "deepseek",
    "qwen",
    "quota",
    "token plan",
    "coding plan",
    "usage",
    "balance",
    "balance monitor",
    "token usage",
    "status bar",
    "model studio",
    "额度监控",
    "国产大模型",
    "百炼",
    "API 余额"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:quotaDeck.dashboard"
  ],
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#1baf7a",
    "theme": "dark"
  },
  "bugs": {
    "url": "https://github.com/AlexMultiAgent/VSC-plugin-quota-deck/issues"
  },
  "homepage": "https://github.com/AlexMultiAgent/VSC-plugin-quota-deck#readme",
  "pricing": "Free",
  "telemetry": null,
  "contributes": {
    "commands": [
      {
        "command": "quotaDeck.openDashboard",
        "title": "%command.openDashboard.title%",
        "category": "QuotaDeck CN",
        "icon": "$(open-preview)"
      },
      {
        "command": "quotaDeck.refresh",
        "title": "%command.refresh.title%",
        "category": "QuotaDeck CN",
        "icon": "$(refresh)"
      },
      {
        "command": "quotaDeck.switchProvider",
        "title": "%command.switchProvider.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.configureMiniMax",
        "title": "%command.configureMiniMax.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.configureDeepSeek",
        "title": "%command.configureDeepSeek.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.loginQwen",
        "title": "%command.loginQwen.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.configureProviders",
        "title": "%command.configureProviders.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.showHelp",
        "title": "%command.showHelp.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.checkConnection",
        "title": "%command.checkConnection.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.openSettings",
        "title": "%command.openSettings.title%",
        "category": "QuotaDeck CN",
        "icon": "$(gear)"
      },
      {
        "command": "quotaDeck.pickTimeZone",
        "title": "%command.pickTimeZone.title%",
        "category": "QuotaDeck CN"
      },
      {
        "command": "quotaDeck.clearCredential",
        "title": "%command.clearCredential.title%",
        "category": "QuotaDeck CN"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "quotaDeck",
          "title": "%viewsContainer.quotaDeck.title%",
          "icon": "media/activity-bar.svg"
        }
      ]
    },
    "views": {
      "quotaDeck": [
        {
          "id": "quotaDeck.overview",
          "name": "%view.quotaDeck.overview.name%"
        }
      ]
    },
    "configuration": {
      "title": "%config.title%",
      "order": 10,
      "properties": {
        "quotaDeck.language": {
          "type": "string",
          "enum": [
            "auto",
            "zh-CN",
            "en-US"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "%config.language.zhCn%",
            "%config.language.enUs%"
          ],
          "default": "auto",
          "scope": "window",
          "order": 10,
          "markdownDescription": "%config.language.description%"
        },
        "quotaDeck.refreshIntervalMinutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 60,
          "default": 3,
          "scope": "window",
          "order": 20,
          "markdownDescription": "%config.refreshIntervalMinutes.description%"
        },
        "quotaDeck.pauseWhenUnfocused": {
          "type": "boolean",
          "default": true,
          "scope": "window",
          "order": 30,
          "markdownDescription": "%config.pauseWhenUnfocused.description%"
        },
        "quotaDeck.statusBar.mode": {
          "type": "string",
          "enum": [
            "all",
            "focused"
          ],
          "enumDescriptions": [
            "%config.statusBarMode.all%",
            "%config.statusBarMode.focused%"
          ],
          "default": "all",
          "scope": "window",
          "order": 40,
          "markdownDescription": "%config.statusBarMode.description%"
        },
        "quotaDeck.statusBar.primaryProvider": {
          "type": "string",
          "enum": [
            "minimax-cn",
            "minimax-global",
            "deepseek",
            "qwen"
          ],
          "enumDescriptions": [
            "%config.primaryProvider.minimaxCn%",
            "%config.primaryProvider.minimaxGlobal%",
            "%config.primaryProvider.deepseek%",
            "%config.primaryProvider.qwen%"
          ],
          "default": "minimax-cn",
          "scope": "window",
          "order": 50,
          "markdownDescription": "%config.primaryProvider.description%"
        },
        "quotaDeck.statusBar.providerOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "minimax-cn",
              "minimax-global",
              "deepseek",
              "qwen"
            ]
          },
          "default": [
            "minimax-cn",
            "minimax-global",
            "deepseek",
            "qwen"
          ],
          "scope": "window",
          "order": 60,
          "markdownDescription": "%config.providerOrder.description%"
        },
        "quotaDeck.statusBar.warningThresholdPercent": {
          "type": "number",
          "minimum": 11,
          "maximum": 99,
          "default": 20,
          "scope": "window",
          "order": 70,
          "markdownDescription": "%config.warningThresholdPercent.description%"
        },
        "quotaDeck.timeZone": {
          "type": "string",
          "default": "auto",
          "scope": "window",
          "order": 80,
          "markdownDescription": "%config.timeZone.description%"
        }
      }
    },
    "menus": {
      "commandPalette": [
        {
          "command": "quotaDeck.openDashboard",
          "when": "true"
        },
        {
          "command": "quotaDeck.checkConnection",
          "when": "true"
        },
        {
          "command": "quotaDeck.configureProviders",
          "when": "true"
        },
        {
          "command": "quotaDeck.configureMiniMax",
          "when": "true"
        },
        {
          "command": "quotaDeck.configureDeepSeek",
          "when": "true"
        },
        {
          "command": "quotaDeck.openSettings",
          "when": "true"
        },
        {
          "command": "quotaDeck.pickTimeZone",
          "when": "true"
        },
        {
          "command": "quotaDeck.clearCredential",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "quotaDeck.refresh",
          "when": "view == quotaDeck.overview",
          "group": "navigation@1"
        },
        {
          "command": "quotaDeck.openDashboard",
          "when": "view == quotaDeck.overview",
          "group": "navigation@2"
        },
        {
          "command": "quotaDeck.openSettings",
          "when": "view == quotaDeck.overview",
          "group": "navigation@3"
        }
      ]
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "icon": "node scripts/make-icon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-vitest.mjs run",
    "test:watch": "node scripts/run-vitest.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:i18n": "node scripts/check-ui-localization.mjs",
    "guard:package": "node scripts/guard-package.mjs",
    "guard:fixtures": "node scripts/guard-fixtures.mjs",
    "vscode:prepublish": "npm run build",
    "package": "npm run build && npm run check:locales && npm run check:i18n && npm run guard:fixtures && node scripts/release-gate.mjs && vsce package --no-dependencies && npm run guard:package"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/vscode": "^1.101.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@vscode/vsce": {
      "minimatch": "^11.0.1"
    }
  }
}
